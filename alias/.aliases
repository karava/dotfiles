# Save you from mistyping
alias sl=ls

##############################
## Custom GIT aliases
##############################
alias gl1='git log --oneline'
# Release to CodeMagic with confirmation prompts
function release-amuse() {
    echo -n "Have you updated the version in pubspec.yaml? [y/N]: "
    read CONFIRM_VERSION
    case "$CONFIRM_VERSION" in
        [yY][eE][sS]|[yY])
            echo -n "Have you made any changes to models that require 'flutter pub run build_runner build'? [y/N]: "
            read CONFIRM_BUILD
            case "$CONFIRM_BUILD" in
                [yY][eE][sS]|[yY])
                    echo "⚠️  Please run 'flutter pub run build_runner build' first, then try again."
                    return 1
                    ;;
                [nN][oO]|[nN])
                    echo "Pushing main branch to origin..."
                    git push origin main
                    if [ $? -ne 0 ]; then
                        echo "❌ Failed to push main branch"
                        return 1
                    fi
                    echo "✅ Main branch pushed successfully!"

                    echo "Creating release tag and pushing to trigger CodeMagic..."
                    git tag -f release && git push origin :refs/tags/release && git push origin release
                    if [ $? -eq 0 ]; then
                        echo "✅ Release tag pushed successfully!"
                        echo "🚀 Release process complete! CodeMagic build should start soon."
                    else
                        echo "❌ Failed to push release tag"
                        return 1
                    fi
                    ;;
                *)
                    echo "Please answer yes or no."
                    return 1
                    ;;
            esac
            ;;
        *)
            echo "Aborting release. Please update the version in pubspec.yaml first."
            return 1
            ;;
    esac
}

# Save a lot of typing for common commands
alias v="vim"
alias gs="git status"
alias dl='cd ~/Downloads'
alias sn="vim ~/notes/scratch.md"
alias eod="~/notes/end_of_day.sh"

# Safety to check when overwriting a file
alias mv="mv -i"

# fetch autocomplete suggestions from Google
function auto() {
    url='https://www.google.com/complete/search?client=hp&hl=en&xhr=t'
    # NB: user-agent must be specified to get back UTF-8 data!
    curl -H 'user-agent: Mozilla/5.0' -sSG --data-urlencode "q=$*" "$url" |
        jq -r ".[1][][0]" |
        sed 's,</\?b>,,g'
}

# Yotube-DL
alias yt="yt-dlp"
alias yta="yt-dlp --extract-audio --audio-format mp3"
alias ytad="yt-dlp --extract-audio --audio-format mp3 --write-description --add-metadata"
alias ytvtt='yt-dlp --skip-download --write-sub --write-auto-sub --sub-lang en --sub-format vtt'

# fd - note not for mac
if [[ "$(uname)" == "Linux" ]]; then
    alias fd=fdfind
fi

# python 3.8
alias python3.8=/usr/bin/python3

# SECRET ALIASES
if [ -f ~/.secret-aliases ]; then
    source ~/.secret-aliases
fi

# For Flutter dev
alias pod-clean="cd ios && rm -rf Pods Podfile.lock && pod install && cd .."

# jrnl
alias jrnl-morning='jrnl --template morning.txt'
alias jrnl-evening='jrnl -on today --format text 2>/dev/null | grep -A2 "conquest" ; echo "---\nPress enter to continue..." ; read ; jrnl --template evening.txt'
